# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
#
# Tiny Matter Dishwasher, ported from the ESP32 version (matter-esp32-tiny-dishwasher)
# to the EFR32MG24 (xG24 Dev Kit, BRD2601B) running Matter over Thread.
#
# Based on the Silicon Labs "matter_thread_soc_dishwasher_app_freertos" sample.
project_name: matter_mg24_acme_dishwasher
label: Matter Thread - Tiny Dishwasher (MG24)
description: A toy Matter dishwasher with Operational State, Dishwasher Mode, On/Off (Dead Front)
  and Device Energy Management (power forecast + start time adjustment).
category: Matter Application
package: matter
quality: experimental

sdk:
  id: simplicity_sdk
  version: 2026.6.2

sdk_extension:
  - id: matter
    version: "2.9.2"
    vendor: silabs

component:
  - id: EFR32MG24B310F1536IM48
  - id: brd2601b
  - id: device_init
  - id: sl_main
  - id: clock_manager
  - id: rail_util_pti
  - id: matter_buttons
  - id: matter_leds
  - id: matter
  - id: matter_platform_mg
  - id: matter_ble
  - id: matter_thread
  - id: matter_ota_support
  - id: matter_crypto
  - id: matter_shell
  - id: matter_gatt_static
  - id: matter_provision_default
  - id: matter_log_uart
  - id: matter_default_lcd_config
  - id: matter_configuration_over_swo
  - id: matter_segger_rtt

  - id: matter_dishwasher
  - id: app_common
  - id: matter_codegen_dm
  - id: matter_access_control
  - id: matter_administrator_commissioning
  - id: matter_basic_information
  - id: matter_bindings
  - id: matter_descriptor
  - id: matter_general_commissioning
  - id: matter_diagnostic_logs
  - id: matter_general_diagnostics
  - id: matter_group_key_mgmt
  - id: matter_identify
  - id: matter_localization_configuration
  - id: matter_network_commissioning
  - id: matter_operational_credentials
  - id: matter_ota_requestor
  - id: matter_software_diagnostics
  - id: matter_thread_network_diagnostics
  - id: matter_user_label
  - id: matter_unit_localization
  - id: matter_time_synchronization

  # Dishwasher endpoint
  - id: matter_operational_state
  - id: matter_mode_base
  - id: matter_on_off

  # Device Energy Management endpoint (+ the SDK's reference DEM delegate)
  - id: matter_dem

  # Commodity Price client (reads prices from a bound tariff device)
  - id: matter_read_client

  # SSD1306 OLED on the expansion header's I2C pins (EXP15/16, shared with the Qwiic connector)
  # The I2C driver rather than I2CSPM, whose transfers can block for 5 minutes with interrupts off
  - id: i2c
    instance:
      - qwiic

requires:
  - name: matter_drivers_series_2

config_file:
  - path: config/common/dishwasher-thread-app.zap
    directory: common
    file_id: zap_config
  - path: config/provision/provision.mattpconf
    directory: provision
    file_id: provision_config

include:
  - path: include
    file_list:
      - path: AppConfig.h
      - path: AppEvent.h
      - path: AppTask.h
      - path: CHIPProjectConfig.h
      - path: DishwasherDelegates.h
      - path: DishwasherManager.h
      - path: EnergyManagement.h
      - path: GridConditionsSubscriber.h
      - path: PriceSubscriber.h
      - path: RotaryEncoder.h
      - path: ShellCommands.h
      - path: Ssd1306.h
      - path: StartPlanner.h
      - path: StatusDisplay.h
      - path: WallClock.h
  - path: third_party/qrcodegen
    file_list:
      - path: qrcodegen.h

source:
  - path: src/main.cpp
  - path: src/AppTask.cpp
  - path: src/DataModelCallbacks.cpp
  - path: src/DishwasherDelegates.cpp
  - path: src/DishwasherManager.cpp
  - path: src/EnergyManagement.cpp
  - path: src/GridConditionsSubscriber.cpp
  - path: src/PriceSubscriber.cpp
  - path: src/RotaryEncoder.cpp
  - path: src/ShellCommands.cpp
  - path: src/Ssd1306.cpp
  - path: src/StartPlanner.cpp
  - path: src/StatusDisplay.cpp
  - path: src/WallClock.cpp
  - path: third_party/qrcodegen/qrcodegen.c

define:
  - name: CHIP_CRYPTO_PLATFORM
    value: "1"
  - name: _WANT_REENT_SMALL
    value: "1"
  - name: NVM3_DEFAULT_NVM_SIZE
    value: "40960"
  - name: NVM3_DEFAULT_MAX_OBJECT_SIZE
    value: "4092"

configuration:
  - name: SL_OPENTHREAD_ENABLE_APP_TASK
    value: 0
  - name: SL_OPENTHREAD_ENABLE_CLI_TASK
    value: 0
  - name: OPENTHREAD_CONFIG_LOG_OUTPUT
    value: OPENTHREAD_CONFIG_LOG_OUTPUT_APP
  - name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
    value: 1
  - name: SL_STACK_SIZE
    value: "4608"
  - name: SL_BT_RTOS_EVENT_HANDLER_STACK_SIZE
    value: "1536"
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  - name: SL_MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS
    value: 1

toolchain_settings:
  - option: cxx_standard
    value: gnu++17

readme:
  - path: README.md

post_build:
  profile: application

other_file:
  - path: qr_code_img.png
